---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Halaman tidak ditemukan">
  <section class="nf bg-ink">
    <div class="container">
      <h1>Halaman tidak ditemukan</h1>
      <p>Alamat yang Anda buka tidak ada atau sudah dipindahkan. Silakan kembali ke beranda atau hubungi kami.</p>
      <div class="hero-actions">
        <a class="btn btn-mint" href="/">Kembali ke beranda</a>
        <a class="btn btn-ghost" href="/kontak">Hubungi kami</a>
      </div>
    </div>
  </section>
</BaseLayout>
