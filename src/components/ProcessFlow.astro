---
import { proses } from '../data/content';
const right = '<svg viewBox="0 0 44 20" width="44" height="20"><path d="M2 10h36M31 3l8 7-8 7"/></svg>';
const left = '<svg viewBox="0 0 44 20" width="44" height="20"><path d="M42 10H8M15 3l-8 7 8 7"/></svg>';
const down = '<svg viewBox="0 0 20 48" width="20" height="48"><path d="M10 2v38M3 33l7 8 7-8"/></svg>';
const downM = '<svg viewBox="0 0 20 40" width="20" height="40"><path d="M10 2v30M3 25l7 8 7-8"/></svg>';
// Arah panah desktop per langkah: 1-3 ke kanan, 4 turun, 5-6 ke kiri, 7 akhir.
const dir = ['r', 'r', 'r', 'd', 'l', 'l', ''];
const svg: Record<string, string> = { r: right, l: left, d: down };
---
<div class="flow">
  {proses.map((s, i) => (
    <div class={`step s${i + 1}${i === proses.length - 1 ? ' last' : ''}`}>
      <div class="n">{i + 1}</div>
      <h3>{s.title}</h3>
      <p>{s.text}</p>
      {dir[i] && <span class={`arrow ${dir[i]}`} aria-hidden="true" set:html={svg[dir[i]]} />}
      {i < proses.length - 1 && <span class="arrow m" aria-hidden="true" set:html={downM} />}
    </div>
  ))}
  <div class="demo-note">
    <b>Demo di setiap akhir sprint</b>
    <span>Anda memberi masukan lebih awal, sehingga risiko berubah arah di akhir proyek jauh lebih kecil.</span>
  </div>
</div>
