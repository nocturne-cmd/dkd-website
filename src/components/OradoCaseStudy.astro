---
import { studiKasusOrado as k } from '../data/projects';
---
<section class="section bg-white" id="studi-kasus-orado">
  <div class="container">
    <h2 class="h2 wide">{k.title}</h2>
    <div class="cs-grid">
      <article class="cs-card">
        <h3>Klien dan industri</h3>
        <p>{k.klien}</p>
      </article>
      <article class="cs-card">
        <h3>Tantangan</h3>
        <p>{k.tantangan}</p>
      </article>
      <article class="cs-card">
        <h3>Solusi</h3>
        <p>{k.solusi}</p>
      </article>
      <article class="cs-card">
        <h3>Teknologi</h3>
        <div class="cs-chips">{k.teknologi.map((t) => <span>{t}</span>)}</div>
      </article>
    </div>
    <div class="cs-results" role="list" aria-label="Hasil proyek">
      {k.hasil.map((h) => (
        <div role="listitem">
          <b>{h.title}</b>
          <span>{h.text}</span>
        </div>
      ))}
    </div>
  </div>
</section>
